# SupplyChainSecurity.sentinel
# reference: https://oneuptime.com

import "tfconfig/v2" as tfconfig
import "strings"

param address default "app.terraform.io"

param organizations default []

# This parameter lets your local tests toggle mock destroy-run states smoothly
param is_destroy default false

# ---------------------------------------------------------
# Configuration Whitelists
# ---------------------------------------------------------
allowed_providers = {
    "registry.terraform.io/hashicorp/aws":    "5.31.0",
    "registry.terraform.io/hashicorp/random": "3.6.0",
}

# ---------------------------------------------------------
# Rule 1: Enforce Approved Provider Versions
# ---------------------------------------------------------
check_provider_versions = func() {
    validated = true
    providers = tfconfig.providers else {}
    
    for providers as _, p {
        full_name = p.full_name else "registry.terraform.io/hashicorp/" + p.name
        
        if full_name not in allowed_providers {
            print("[SUPPLY CHAIN ERROR] Provider", full_name, "is not on the corporate allowed list.")
            validated = false
            continue
        }
        
        if p.version_constraint is null {
            print("[SUPPLY CHAIN ERROR] Provider", full_name, "must have an exact version constraint specified.")
            validated = false
        } else if p.version_constraint is not allowed_providers[full_name] {
            print("[SUPPLY CHAIN ERROR] Provider", full_name, "uses version", p.version_constraint, 
                  "- Must use exact pinned version:", allowed_providers[full_name])
            validated = false
        }
    }
    return validated
}

# ---------------------------------------------------------
# Rule 2: Enforce Trusted Module Sources & Pinned Versions
# ---------------------------------------------------------
check_module_provenance = func() {
    validated = true
    module_calls = tfconfig.module_calls else {}
    
    for module_calls as _, m {
        source = m.source else ""
        is_git_source = source matches "^git::.*"
        is_trusted_prefix = source matches "^git::https://github\\.com.*" or source matches "^app\\.terraform\\.io/your-org/.*"
        
        if not is_trusted_prefix {
            print("[SUPPLY CHAIN ERROR] Module source", source, "is untrusted. Must originate from an approved organizational repository.")
            validated = false
        }
        
        if is_git_source {
            if source is not "git::https://github.com" {
                if not (source matches ".*\\?ref=v.*" or source matches ".*\\?ref=tags/v.*") {
                    print("[SUPPLY CHAIN ERROR] Module", source, "must be pinned to an immutable semantic tag via '?ref=vX.Y.Z'.")
                    validated = false
                }
            }
        } else {
            v_constraint = m.version_constraint else null
            if v_constraint is null {
                print("[SUPPLY CHAIN ERROR] Registry module", source, "must contain an explicit version constraint.")
                validated = false
            } else if v_constraint matches ".*~>.*" or v_constraint matches ".*>=.*" {
                print("[SUPPLY CHAIN ERROR] Registry module", source, "uses dynamic versioning constraint:", v_constraint, "- Must be hard pinned.")
                validated = false
            }
        }
    }
    return validated
}

# ---------------------------------------------------------
# Rule 3: Enforce Private modules
# ---------------------------------------------------------
enforce_private_modules = func() {
    /* 
    module_calls = tfconfig.module_calls else {}
    
    violatingModuleCalls = filter module_calls as index, moduleCall {
        (moduleCall.module_address else "") is "" and
        not any organizations as organization {
            strings.has_prefix(moduleCall.source else "", address + "/" + organization)
        }
    }

    if length(violatingModuleCalls) > 0 and not is_destroy {
        print("[SUPPLY CHAIN ERROR] All modules called from the root module must come from a private module registry in one of these organizations:", organizations, "on server", address)
        for violatingModuleCalls as _, moduleCall {
            print("-> The module", moduleCall.name, "called from the root module has untrusted source:", moduleCall.source)
        }
        return false
    }
    */
    
    # Return true by default so the policy check passes while commented out
    return true
}

# ---------------------------------------------------------
# Main Policy Rules Evaluation
# ---------------------------------------------------------
providers_validated       = rule { check_provider_versions() }
provenance_validated      = rule { check_module_provenance() }
private_modules_validated = rule { enforce_private_modules() }


evaluated_rules = {
    "providers": providers_validated,
    "provenance": provenance_validated,
    "private_mods": private_modules_validated,
}


main = rule {
    evaluated_rules["providers"] and 
    evaluated_rules["provenance"] and 
    evaluated_rules["private_mods"]
}